---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CartDrawer from '@/components/CartDrawer.astro';
import { siteConfig } from '@/config/site';

interface Props {
  title?: string;
  description?: string;
  hideHotBar?: boolean;
}

const { title, description, hideHotBar = false } = Astro.props;
const pageTitle = title ? `${title} — ${siteConfig.storeName}` : `${siteConfig.storeName} — ${siteConfig.slogan}`;
const pageDesc = description ?? siteConfig.slogan;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0b0d10" />
  <meta name="description" content={pageDesc} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:type" content="website" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🛒%3C/text%3E%3C/svg%3E" />
  <title>{pageTitle}</title>
</head>
<body>
  {!hideHotBar && (
    <div class="hotbar" set:html={siteConfig.hotBanner} />
  )}
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <CartDrawer />
  <div class="toast" id="toast">
    <span class="toast-check">✓</span>
    <span id="toast-msg">Agregado al carrito</span>
  </div>

  <script>
    import { readCart, cartCount } from '@/scripts/cart';

    // Sync cart badge
    const syncBadge = () => {
      const n = cartCount(readCart());
      document.querySelectorAll<HTMLElement>('[data-cart-badge]').forEach(el => {
        el.dataset.count = String(n);
        el.textContent = String(n);
      });
    };
    syncBadge();
    window.addEventListener('cart:change', syncBadge);
    window.addEventListener('storage', (e) => {
      if (e.key === 'gamistore:cart') syncBadge();
    });

    // Fade-in on scroll
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      });
    }, { rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.fade-up').forEach(el => io.observe(el));

    // Mobile nav
    const menuBtn = document.querySelector<HTMLElement>('[data-menu-toggle]');
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    menuBtn?.addEventListener('click', () => {
      nav?.classList.toggle('open');
    });
    document.querySelectorAll('[data-nav] a').forEach(a => {
      a.addEventListener('click', () => nav?.classList.remove('open'));
    });

    // Toast
    window.addEventListener('toast', ((e: CustomEvent) => {
      const t = document.getElementById('toast');
      const m = document.getElementById('toast-msg');
      if (!t || !m) return;
      m.textContent = e.detail?.msg ?? 'Agregado al carrito';
      t.classList.add('show');
      clearTimeout((window as any).__toastT);
      (window as any).__toastT = setTimeout(() => t.classList.remove('show'), 2000);
    }) as EventListener);
  </script>
</body>
</html>
