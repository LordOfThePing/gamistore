---
import { siteConfig } from '@/config/site';
---
<section class="hero">
  <div class="container hero-inner">
    <div>
      <span class="hero-eyebrow">⚡ Nuevos modelos 2026</span>
      <h1>{siteConfig.heroHeadline}</h1>
      <p>{siteConfig.heroSubheadline}</p>
      <div class="hero-ctas">
        <a href="#destacados" class="btn btn-primary">Ver destacados</a>
        <a href="/categoria/iphone" class="btn btn-ghost">Explorar iPhone →</a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-visual-inner">
        <div class="hero-visual-emoji">📱</div>
      </div>
    </div>
  </div>
</section>
