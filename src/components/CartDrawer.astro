---
import { siteConfig } from '@/config/site';
---
<div class="drawer-backdrop" data-drawer-backdrop></div>
<aside class="drawer" data-drawer aria-label="Carrito">
  <div class="drawer-head">
    <h3>Tu carrito</h3>
    <button class="drawer-close" data-drawer-close aria-label="Cerrar">
      <svg viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </div>
  <div class="drawer-body" data-drawer-body>
    <div class="drawer-empty" data-drawer-empty>
      <div class="drawer-empty-emoji">🛍️</div>
      <p>Tu carrito está vacío.</p>
      <a href="/#destacados" class="btn btn-ghost" data-drawer-close-link>Ver productos destacados</a>
    </div>
  </div>
  <div class="drawer-foot" data-drawer-foot hidden>
    <div class="drawer-total">
      <span>Total</span>
      <span data-drawer-total>$0</span>
    </div>
    <div class="drawer-sub">
      Vas a finalizar tu compra por WhatsApp. Un asesor confirma stock y forma de pago.
    </div>
    <button class="btn btn-wa drawer-checkout" data-checkout>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.555-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.595 5.392l-.999 3.648 3.893-.739z"/></svg>
      Finalizar por WhatsApp
    </button>
  </div>
</aside>

<script define:vars={{ waNumber: siteConfig.whatsappNumber, storeName: siteConfig.storeName, locale: siteConfig.locale, currency: siteConfig.currencyCode }}>
  const money = (n) => new Intl.NumberFormat(locale, { style: 'currency', currency, maximumFractionDigits: 0 }).format(n);

  const read = () => {
    try { return JSON.parse(localStorage.getItem('gamistore:cart') || '{}'); }
    catch { return {}; }
  };
  const write = (c) => {
    localStorage.setItem('gamistore:cart', JSON.stringify(c));
    window.dispatchEvent(new CustomEvent('cart:change'));
  };

  const bodyEl = document.querySelector('[data-drawer-body]');
  const emptyEl = document.querySelector('[data-drawer-empty]');
  const footEl = document.querySelector('[data-drawer-foot]');
  const totalEl = document.querySelector('[data-drawer-total]');
  const drawer = document.querySelector('[data-drawer]');
  const backdrop = document.querySelector('[data-drawer-backdrop]');

  const renderDrawer = () => {
    const c = read();
    const lines = Object.values(c);
    // Clear items (keep empty state)
    bodyEl.querySelectorAll('.cart-item').forEach(n => n.remove());
    if (lines.length === 0) {
      emptyEl.style.display = '';
      footEl.hidden = true;
      return;
    }
    emptyEl.style.display = 'none';
    footEl.hidden = false;
    let total = 0;
    lines.forEach((l) => {
      total += l.price * l.qty;
      const row = document.createElement('div');
      row.className = 'cart-item';
      row.innerHTML = `
        <div class="cart-item-img">${l.emoji}</div>
        <div>
          <div class="cart-item-name">${l.name}</div>
          <div class="cart-item-price">${money(l.price)}</div>
          <div class="cart-qty">
            <button data-dec="${l.id}" aria-label="Quitar">−</button>
            <span>${l.qty}</span>
            <button data-inc="${l.id}" aria-label="Agregar">+</button>
          </div>
        </div>
        <button class="cart-remove" data-remove="${l.id}" aria-label="Eliminar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>
        </button>
      `;
      bodyEl.appendChild(row);
    });
    totalEl.textContent = money(total);
  };

  const openDrawer = () => { drawer.classList.add('open'); backdrop.classList.add('open'); document.body.style.overflow = 'hidden'; renderDrawer(); };
  const closeDrawer = () => { drawer.classList.remove('open'); backdrop.classList.remove('open'); document.body.style.overflow = ''; };

  window.addEventListener('drawer:open', openDrawer);
  window.addEventListener('cart:change', () => { if (drawer.classList.contains('open')) renderDrawer(); });
  backdrop.addEventListener('click', closeDrawer);
  document.querySelector('[data-drawer-close]').addEventListener('click', closeDrawer);
  document.querySelector('[data-drawer-close-link]')?.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDrawer(); });

  // Delegated qty / remove / add
  bodyEl.addEventListener('click', (e) => {
    const t = e.target.closest('[data-inc], [data-dec], [data-remove]');
    if (!t) return;
    const c = read();
    const id = t.dataset.inc || t.dataset.dec || t.dataset.remove;
    if (!c[id]) return;
    if (t.dataset.inc) c[id].qty += 1;
    if (t.dataset.dec) { c[id].qty -= 1; if (c[id].qty <= 0) delete c[id]; }
    if (t.dataset.remove) delete c[id];
    write(c);
  });

  // Add-to-cart from product cards
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-add-to-cart]');
    if (!btn) return;
    const { id, name, price, emoji } = btn.dataset;
    const c = read();
    c[id] = c[id]
      ? { ...c[id], qty: c[id].qty + 1 }
      : { id, name, price: Number(price), emoji, qty: 1 };
    write(c);
    btn.classList.add('added');
    btn.textContent = '✓ Agregado';
    setTimeout(() => { btn.classList.remove('added'); btn.textContent = '+ Agregar al carrito'; }, 1400);
    window.dispatchEvent(new CustomEvent('toast', { detail: { msg: `${name} agregado` } }));
  });

  // WhatsApp checkout
  document.querySelector('[data-checkout]').addEventListener('click', () => {
    const c = read();
    const lines = Object.values(c);
    if (lines.length === 0) return;
    const lineText = lines.map(l => `• ${l.name} × ${l.qty} — ${money(l.price * l.qty)}`).join('\n');
    const total = lines.reduce((s, l) => s + l.price * l.qty, 0);
    const msg = [
      `Hola ${storeName}! Quiero hacer este pedido:`,
      '',
      lineText,
      '',
      `*Total:* ${money(total)}`,
      '',
      'Me pasan info de stock, pago y envío? Gracias!'
    ].join('\n');
    const url = `https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`;
    window.open(url, '_blank', 'noopener');
  });
</script>
