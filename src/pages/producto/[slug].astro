---
import Layout from '@/layouts/Layout.astro';
import ProductCard from '@/components/ProductCard.astro';
import TrustBar from '@/components/TrustBar.astro';
import { categories } from '@/data/categories';
import { products, getByCategory, type Product } from '@/data/products';
import { money, cuotasOf, percentOff } from '@/lib/format';
import { siteConfig } from '@/config/site';

export function getStaticPaths() {
  return products.map(p => ({ params: { slug: p.id } }));
}

const { slug } = Astro.params as { slug: string };
const product = products.find(p => p.id === slug) as Product;
const cat = categories[product.category];
const related = getByCategory(product.category).filter(p => p.id !== product.id).slice(0, 8);
const off = product.oldPrice ? percentOff(product.price, product.oldPrice) : 0;
const waUrl = `https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(`Hola! Me interesa el ${product.name}. ¿Me pasan info de stock y pago?`)}`;
---
<Layout title={product.name} description={`${product.name} — ${cat.name}. ${money(product.price)}. Garantía oficial, 12 cuotas sin interés.`}>
  <section class="container">
    <div style="padding: 20px 0; font-size: 13px; color: var(--fg-dim);">
      <a href="/" style="color: inherit;">Inicio</a> <span style="margin: 0 6px;">/</span>
      <a href={`/categoria/${cat.key}`} style="color: inherit;">{cat.name}</a> <span style="margin: 0 6px;">/</span>
      <span style="color: var(--fg-muted);">{product.name}</span>
    </div>
    <div class="pdp">
      <div class="pdp-gallery" style={`--card-bg-a: ${cat.bgA}; --card-bg-b: ${cat.bgB}`}>
        <span class="pdp-gallery-emoji">{cat.emoji}</span>
        <div style="position: absolute; top: 20px; left: 20px; display: flex; gap: 8px;">
          {product.badge === 'HOT' && <span class="badge badge-hot">🔥 Hot</span>}
          {product.badge === 'NEW' && <span class="badge badge-new">Nuevo</span>}
          {product.badge === 'SALE' && off > 0 && <span class="badge badge-sale">-{off}%</span>}
        </div>
      </div>
      <div>
        <div class="pdp-cat">{cat.name}</div>
        <h1>{product.name}</h1>
        <div class="pdp-price">
          <span class="price">{money(product.price)}</span>
          {product.oldPrice && <span class="old">{money(product.oldPrice)}</span>}
        </div>
        <div class="pdp-cuotas">💳 {cuotasOf(product.price)}</div>

        <div class="pdp-highlights">
          <div class="pdp-highlight"><span class="pdp-highlight-emoji">🚚</span><span class="pdp-highlight-text"><strong>Envío gratis</strong> a todo el país en compras +$500k</span></div>
          <div class="pdp-highlight"><span class="pdp-highlight-emoji">🛡️</span><span class="pdp-highlight-text"><strong>12 meses</strong> de garantía oficial</span></div>
          <div class="pdp-highlight"><span class="pdp-highlight-emoji">✅</span><span class="pdp-highlight-text"><strong>100% original</strong>, caja sellada</span></div>
          <div class="pdp-highlight"><span class="pdp-highlight-emoji">💬</span><span class="pdp-highlight-text"><strong>Atención</strong> por WhatsApp 7 días</span></div>
        </div>

        <div class="pdp-ctas">
          <button
            class="btn btn-primary"
            data-add-to-cart
            data-id={product.id}
            data-name={product.name}
            data-price={product.price}
            data-emoji={cat.emoji}
          >+ Agregar al carrito</button>
          <a href={waUrl} target="_blank" rel="noopener" class="btn btn-wa">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.555-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.595 5.392l-.999 3.648 3.893-.739z"/></svg>
            Consultar por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head"><h2>También te puede interesar</h2></div>
        <div class="product-grid">
          {related.map(p => <ProductCard product={p} />)}
        </div>
      </div>
    </section>
  )}

  <TrustBar />
</Layout>
