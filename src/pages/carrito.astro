---
import Layout from '@/layouts/Layout.astro';
import { siteConfig } from '@/config/site';
---
<Layout title="Carrito" hideHotBar={true}>
  <section class="section">
    <div class="container">
      <h1 style="margin-bottom: 10px;">Tu carrito</h1>
      <p style="margin-bottom: 30px;">Revisá tus productos y finalizá tu compra por WhatsApp. Un asesor te confirma stock y forma de pago.</p>

      <div id="cart-empty" style="text-align: center; padding: 60px 20px; background: var(--bg-elev); border-radius: var(--radius); border: 1px solid var(--border);">
        <div style="font-size: 3rem; margin-bottom: 10px;">🛍️</div>
        <h3 style="margin-bottom: 6px;">Tu carrito está vacío</h3>
        <p>Agregá productos desde el catálogo.</p>
        <a href="/" class="btn btn-primary" style="margin-top: 10px;">Explorar productos</a>
      </div>

      <div id="cart-wrap" hidden>
        <div style="display: grid; grid-template-columns: 1fr 340px; gap: 30px; align-items: flex-start;">
          <div id="cart-lines" style="background: var(--bg-elev); border: 1px solid var(--border); border-radius: var(--radius); padding: 10px 20px;"></div>
          <aside style="background: var(--bg-elev); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; position: sticky; top: calc(var(--header-h) + 20px);">
            <h3 style="margin-bottom: 20px;">Resumen</h3>
            <div style="display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 14px; color: var(--fg-muted);">
              <span>Subtotal</span><span id="cart-subtotal">$0</span>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 20px; font-size: 14px; color: var(--fg-muted);">
              <span>Envío</span><span>A coordinar</span>
            </div>
            <div style="display: flex; justify-content: space-between; padding: 16px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); margin-bottom: 20px;">
              <strong>Total</strong><strong id="cart-total" style="font-size: 1.3rem;">$0</strong>
            </div>
            <button class="btn btn-wa" id="cart-checkout" style="width: 100%; padding: 14px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.555-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.595 5.392l-.999 3.648 3.893-.739z"/></svg>
              Finalizar por WhatsApp
            </button>
            <p style="font-size: 12px; color: var(--fg-dim); margin: 14px 0 0; text-align: center;">
              Un asesor confirma stock y forma de pago (efectivo, transferencia o tarjeta hasta 12 cuotas).
            </p>
          </aside>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  @media (max-width: 820px) {
    #cart-wrap > div { grid-template-columns: 1fr !important; }
    aside { position: static !important; }
  }
</style>

<script define:vars={{ waNumber: siteConfig.whatsappNumber, storeName: siteConfig.storeName, locale: siteConfig.locale, currency: siteConfig.currencyCode }}>
  const money = (n) => new Intl.NumberFormat(locale, { style: 'currency', currency, maximumFractionDigits: 0 }).format(n);
  const read = () => { try { return JSON.parse(localStorage.getItem('gamistore:cart') || '{}'); } catch { return {}; } };
  const write = (c) => { localStorage.setItem('gamistore:cart', JSON.stringify(c)); window.dispatchEvent(new CustomEvent('cart:change')); };

  const emptyEl = document.getElementById('cart-empty');
  const wrapEl = document.getElementById('cart-wrap');
  const linesEl = document.getElementById('cart-lines');
  const subEl = document.getElementById('cart-subtotal');
  const totEl = document.getElementById('cart-total');

  const render = () => {
    const c = read();
    const lines = Object.values(c);
    if (lines.length === 0) {
      emptyEl.hidden = false;
      wrapEl.hidden = true;
      return;
    }
    emptyEl.hidden = true;
    wrapEl.hidden = false;
    linesEl.innerHTML = '';
    let total = 0;
    lines.forEach((l) => {
      total += l.price * l.qty;
      const row = document.createElement('div');
      row.className = 'cart-item';
      row.innerHTML = `
        <div class="cart-item-img" style="width: 90px; height: 90px; font-size: 2.4rem;">${l.emoji}</div>
        <div>
          <div class="cart-item-name" style="font-size: 15px;">${l.name}</div>
          <div class="cart-item-price">${money(l.price)}</div>
          <div class="cart-qty">
            <button data-dec="${l.id}">−</button><span>${l.qty}</span><button data-inc="${l.id}">+</button>
          </div>
        </div>
        <div style="text-align: right;">
          <div style="font-weight: 700; margin-bottom: 10px;">${money(l.price * l.qty)}</div>
          <button class="cart-remove" data-remove="${l.id}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/></svg>
          </button>
        </div>
      `;
      linesEl.appendChild(row);
    });
    subEl.textContent = money(total);
    totEl.textContent = money(total);
  };

  render();
  window.addEventListener('cart:change', render);

  linesEl.addEventListener('click', (e) => {
    const t = e.target.closest('[data-inc], [data-dec], [data-remove]');
    if (!t) return;
    const c = read();
    const id = t.dataset.inc || t.dataset.dec || t.dataset.remove;
    if (!c[id]) return;
    if (t.dataset.inc) c[id].qty += 1;
    if (t.dataset.dec) { c[id].qty -= 1; if (c[id].qty <= 0) delete c[id]; }
    if (t.dataset.remove) delete c[id];
    write(c);
  });

  document.getElementById('cart-checkout').addEventListener('click', () => {
    const c = read();
    const lines = Object.values(c);
    if (lines.length === 0) return;
    const lineText = lines.map(l => `• ${l.name} × ${l.qty} — ${money(l.price * l.qty)}`).join('\n');
    const total = lines.reduce((s, l) => s + l.price * l.qty, 0);
    const msg = [
      `Hola ${storeName}! Quiero hacer este pedido:`,
      '',
      lineText,
      '',
      `*Total:* ${money(total)}`,
      '',
      'Me pasan info de stock, pago y envío? Gracias!'
    ].join('\n');
    window.open(`https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`, '_blank', 'noopener');
  });
</script>
